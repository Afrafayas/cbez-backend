{
  "info": {
    "_postman_id": "cbez-banners-api-v1",
    "name": "Cbez - Banners & Ads API",
    "description": "Postman Collection for Cbez B2C Banner & Ads Management Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "bannerId",
      "value": "REPLACE_WITH_BANNER_ID",
      "type": "string"
    },
    {
      "key": "shopId",
      "value": "REPLACE_WITH_SHOP_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Public - Get Active Banners (Website Slider)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/banners/active",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners",
            "active"
          ],
          "query": [
            {
              "key": "type",
              "value": "banner",
              "description": "Optional: 'banner' or 'ads'",
              "disabled": true
            }
          ]
        },
        "description": "Public endpoint to fetch active, non-deleted banners for customer website."
      },
      "response": []
    },
    {
      "name": "2. Admin - Get All Banners",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/banners",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners"
          ],
          "query": [
            {
              "key": "type",
              "value": "ads",
              "description": "Filter by type: 'ads' or 'banner'",
              "disabled": true
            },
            {
              "key": "isActive",
              "value": "true",
              "description": "Filter by status: 'true' or 'false'",
              "disabled": true
            }
          ]
        },
        "description": "Admin endpoint to list all banners with optional filtering."
      },
      "response": []
    },
    {
      "name": "3. Admin - Get Banner By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/banners/{{bannerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners",
            "{{bannerId}}"
          ]
        },
        "description": "Admin endpoint to retrieve a single banner details by ID."
      },
      "response": []
    },
    {
      "name": "4. Admin - Create Platform Banner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Mega Festive Offer 2026\",\n  \"details\": \"Special discounts and offers across all verified stores\",\n  \"image\": \"https://images.unsplash.com/photo-1511707171634-5f897ff02560\",\n  \"type\": \"banner\",\n  \"isActive\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/banners",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners"
          ]
        },
        "description": "Create a platform-level banner (shopId will be null)."
      },
      "response": []
    },
    {
      "name": "5. Admin - Create Shop Ad",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Certified iPhones at Rahul Mobiles\",\n  \"details\": \"iPhone 13 & 14 starting at ₹32,000 with 6-month warranty\",\n  \"image\": \"https://images.unsplash.com/photo-1592899677977-9c10ca588bbd\",\n  \"type\": \"ads\",\n  \"shopId\": \"{{shopId}}\",\n  \"isActive\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/banners",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners"
          ]
        },
        "description": "Create a shop ad banner (shopId is mandatory)."
      },
      "response": []
    },
    {
      "name": "6. Admin - Update Banner (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Banner Title\",\n  \"details\": \"Updated offer details and text\",\n  \"image\": \"https://images.unsplash.com/photo-1511707171634-5f897ff02560\",\n  \"isActive\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/banners/{{bannerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners",
            "{{bannerId}}"
          ]
        },
        "description": "Full or partial update of banner via PUT."
      },
      "response": []
    },
    {
      "name": "7. Admin - Update Banner (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Quick Patched Title\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/banners/{{bannerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners",
            "{{bannerId}}"
          ]
        },
        "description": "Partial update of banner fields via PATCH."
      },
      "response": []
    },
    {
      "name": "8. Admin - Toggle Status (ON/OFF)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isActive\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/banners/{{bannerId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners",
            "{{bannerId}}",
            "status"
          ]
        },
        "description": "Toggle active/inactive status without altering other banner details."
      },
      "response": []
    },
    {
      "name": "9. Admin - Delete Banner (Soft Delete)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/banners/{{bannerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "banners",
            "{{bannerId}}"
          ]
        },
        "description": "Soft delete a banner so it is excluded from public queries."
      },
      "response": []
    }
  ]
}