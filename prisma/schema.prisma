// Prisma schema for MongoDB Atlas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String?  @unique
  password  String?
  name      String
  phone     String?  @unique
  role      String   @default("customer") // "customer" | "seller" | "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop             Shop?
  activities       ActivityLog[]
  follows          Follow[]
  networkInquiries NetworkInquiry[]
}

model Shop {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  ownerName String
  phone     String
  whatsapp  String
  address   String
  city      String
  category  String
  verified  Boolean  @default(false)
  rating    Float    @default(4.5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String   @unique @db.ObjectId
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  products  Product[]
  leads     Lead[]
  followers Follow[]
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  brand       String
  category    String
  description String
  price       Float
  stock       Int      @default(1)
  specsJson   String   @default("{}") // Stored as JSON string e.g. {"RAM": "8GB"}
  imagesJson  String   @default("[]") // Stored as JSON string of image URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shopId      String   @db.ObjectId
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  leads       Lead[]
}

model Lead {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  productName   String
  customerName  String
  customerPhone String
  contactType   String   // "call" | "whatsapp"
  createdAt     DateTime @default(now())

  shopId        String   @db.ObjectId
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  productId     String?  @db.ObjectId
  product       Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Follow {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopId    String   @db.ObjectId
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
}

model NetworkInquiry {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerName  String
  customerPhone String
  customerEmail String?
  city          String
  category      String
  gadgetNeeded  String
  targetBudget  Float?
  notes         String?
  createdAt     DateTime @default(now())

  userId        String?  @db.ObjectId
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String?  @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}
